{
  "name": "tetrikanets-local-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "model:archive": "node scripts/create-model-archive.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "model:download": "node scripts/download-model.mjs",
    "runtime:download": "node scripts/prepare-low-memory-runtime.mjs",
    "runtime:verify": "node scripts/verify-low-memory-runtime.mjs",
    "reference:download": "node scripts/download-reference.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.cors.config.ts && playwright test --config playwright.archive.config.ts",
    "test:gpu": "playwright test --config playwright.gpu.config.ts",
    "translator:download": "node scripts/download-translator.mjs",
    "runtime:prepare": "node scripts/prepare-low-memory-runtime.mjs",
    "prebuild": "node scripts/prepare-low-memory-runtime.mjs",
    "model:download:light": "node scripts/download-model.mjs --profile scripts/light-model-source.json",
    "runtime:verify:light": "node scripts/verify-light-model-runtime.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mlc-ai/web-llm": "0.2.86",
    "@noble/hashes": "2.0.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.11.1",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@webgpu/types": "0.1.69",
    "typescript": "5.9.3",
    "undici": "8.12.3",
    "vite": "8.3.5",
    "vitest": "4.1.0"
  }
}
