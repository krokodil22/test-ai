{
  "name": "tetrikanets-local-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "model:download": "node scripts/download-model.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.cors.config.ts",
    "test:gpu": "playwright test --config playwright.gpu.config.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.79",
    "dompurify": "3.4.17",
    "highlight.js": "11.11.1",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@webgpu/types": "0.1.69",
    "typescript": "5.9.3",
    "undici": "8.12.3",
    "vite": "8.3.5",
    "vitest": "4.1.0"
  }
}
